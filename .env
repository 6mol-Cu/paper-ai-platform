# ================== 客户端变量（安全，可暴露给前端） ==================
# APP ID
NEXT_PUBLIC_APP_ID=8575fc8c-07fd-42be-9c57-556a14f2a33c

# APP type
# true for workflow apps
NEXT_PUBLIC_APP_TYPE_WORKFLOW=true

# Base URL path for the application
NEXT_PUBLIC_APP_BASE_URL_PATH=

# API prefix path for the application (前端调用本地 API 的前缀)
NEXT_PUBLIC_API_PREFIX=/api

# ================== 服务端变量（机密，不会暴露给前端） ==================
# Dify API key (仅服务端使用)
APP_API_KEY=app-V9pjpERsCVaXaXqyEuvo9lVu

# Dify API url (仅服务端使用)
APP_API_URL=http://8.149.128.82/v1
